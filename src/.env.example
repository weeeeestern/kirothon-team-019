# 브라우저 공개용 카카오 JavaScript 키. 카카오맵 사용 설정과 웹 도메인 등록 필요.
VITE_KAKAO_JS_KEY=

# 브라우저 공개용 ODsay Web/URI 키. Server 키를 넣지 않는다.
# Service URI: kirothon-team-019.vercel.app / localhost:5174
# Vercel Production에 설정 후 재배포. Web 키 미설정 시 서버 경로를 사용한다.
VITE_ODSAY_WEB_KEY=

# 서버/수집기 전용. 실제 값은 커밋하지 않고 VITE_*로 변경하지 않는다.
PUBLIC_DATA_API_KEY=
SEOUL_DATA_API_KEY=
SEOUL_SUBWAY_REALTIME_API_KEY=
ODSAY_API_KEY=
# 서버 호출용 ODsay 키와 호출 서버 IP 등록 필요. 웹용 키와 혼용하지 않는다.
# Vercel의 실제 외부 송신 IP가 등록 IP와 일치해야 한다. 고정 송신 IP 구성이 필요할 수 있다.

# 권장 서버 변수. 기존 NEXT_PUBLIC_ 이름은 서버에서만 호환한다.
KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_REST_API_KEY=
# 기존 JavaScript 키 호환. /api/map-config는 지도 JS 키와 명시적 ODsay Web 키만 반환한다.
NEXT_PUBLIC_KAKAO_JS_KEY=

# DB 연동은 아직 구현되지 않음.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_URL=

# VITE_DATA_MODE는 설계만 있으며 현재 앱은 읽지 않는다.
