# 현재 지도 컴포넌트가 읽는 브라우저용 JavaScript 키.
# 기존 .env의 NEXT_PUBLIC_KAKAO_JS_KEY와 이름이 다름.
VITE_KAKAO_JS_KEY=

# Supabase. 비우면 localStorage 데모 모드로 동작한다. anon 키만 넣고 service_role 키는 절대 넣지 않는다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 아래는 기존 .env에 있는 이름의 목록. 현재 소비 코드가 없는 설정이다.
# 실제 값은 커밋하지 않는다. 서버/수집기 비밀키를 VITE_*로 변경하지 않는다.
PUBLIC_DATA_API_KEY=
SEOUL_DATA_API_KEY=
SEOUL_SUBWAY_REALTIME_API_KEY=
ODSAY_API_KEY=

# 기존 이름. REST 키는 서버/수집기 전용으로만 사용한다.
NEXT_PUBLIC_KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_JS_KEY=

# DB 연동은 아직 구현되지 않음.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_URL=

# VITE_DATA_MODE는 설계만 있으며 현재 앱은 읽지 않는다.
